# Build / runtime noise
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Secrets / env — never commit
.env
.env.*
*.key
*.pem

# Data artifacts this plugin must never ship
*.db

# Raw AST inventory dumps — the readable output is CODEBASE-REPORT.md, which is committed;
# the JSON is a regenerable intermediate and nothing references it.
docs/inventory-*.json

# Timestamped backups produced by scripts/claudemd_splice.py
*.bak

# OS noise
.DS_Store

# Vendored reference implementations — build scaffolding, not ship artifacts
reference/

# Vouch session ledger (local, not shipped)
.vouch/

# context-os per-session read ledger (local telemetry, not shipped)
.context-os/reads-*.jsonl
